{
  "name": "takyondb",
  "version": "0.1.0",
  "description": "TypeScript SDK wrapper for the ultra-low-latency TakyonDB storage engine",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./addon": {
      "types": "./dist/client/addon.d.ts",
      "default": "./dist/client/addon.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "prebuilds",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joacokhzyx/takyondb.git",
    "directory": "src/sdk/ts"
  },
  "bugs": {
    "url": "https://github.com/joacokhzyx/takyondb/issues"
  },
  "homepage": "https://github.com/joacokhzyx/takyondb#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc --noEmit && vitest run",
    "test:unit": "vitest run",
    "prepack": "node ./scripts/prepack.mjs",
    "test:relational": "vitest run ../client/relational",
    "bench:relational": "node ../../../scripts/bench_relational.js",
    "lint": "cd .. && node ./ts/node_modules/eslint/bin/eslint.js client takyon.ts index.ts",
    "format": "prettier --write '../**/*.ts'",
    "build:addon": "cd ../../../ && zig build -Doptimize=ReleaseSafe",
    "examples": "node ../../../scripts/examples_check.js"
  },
  "keywords": [
    "database",
    "zero-copy",
    "shared-memory",
    "typescript",
    "zig"
  ],
  "author": "TakyonDB Contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "node-api-headers": "^1.9.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
