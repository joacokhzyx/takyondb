# Zig build artifacts
.zig-cache/
zig-cache/
zig-out/

# TakyonDB runtime artifacts (never commit database files)
data.takyon*
*.snap
*.node

# Native build outputs
*.exe
*.dll
*.lib
*.pdb
*.obj
*.o
*.a
*.so
*.dylib

# Windows import lib (fetch in CI, do not commit)
/lib/node.lib

# Node.js / TypeScript build artifacts
node_modules/
dist/
build/
coverage/
*.log
.npm/
# LICENSE copy staged by src/sdk/ts prepack (do not commit; source is /LICENSE)
src/sdk/ts/LICENSE

# Compiled JS next to TS sources (generate via tsc, do not commit)
src/sdk/**/*.js
!src/sdk/eslint.config.js
# NOTE: most scripts/*.js are tracked for CI compat (legacy), but a .js
# emitted next to its own .ts is build output and must not be committed.
# e2e_zerocopy_test.js was exactly that: the compiled form of the .ts, run
# by CI while the runner ran the .ts, so the two could drift apart silently.
scripts/e2e_zerocopy_test.js

# Local-only agent knowledge base (style guides, research dossiers).
# These are working notes, never project documentation. Do not "fix" this.
.agents/

# OS-specific files
.DS_Store
Thumbs.db

# IDE settings
.vscode/
.idea/
*.swp
*.swo

# Env / secrets
.env
.env.*
